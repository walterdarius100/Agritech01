# Browser transport: reuse existing values; no EmailJS private key required.
CONTACT_ENABLED=false
CONTACT_EMAIL_TRANSPORT=browser
CONTACT_ALLOWED_ORIGINS=
CONTACT_HMAC_SECRET=
# Reservations for contact emails only; allow room for newsletter in EmailJS quota.
CONTACT_MONTHLY_EMAIL_BUDGET=100
# true only after a distinct browser autoReplyTemplateId is configured.
CONTACT_BROWSER_REPLY_ENABLED=false
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY come from Edge runtime.
# Optional server transport and its existing EmailJS settings: docs/communication-v12.md.
