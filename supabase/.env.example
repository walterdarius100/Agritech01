# Documentation only. No actual secrets, no external activation.
CONTACT_ENABLED=false
CONTACT_ALLOWED_ORIGINS=
CONTACT_HMAC_SECRET=
CONTACT_EMAIL_ENABLED=false
CONTACT_MONTHLY_EMAIL_BUDGET=0
# Provider actually connected to the existing EmailJS service, after dashboard audit:
EMAILJS_CONNECTED_PROVIDER=
EMAILJS_PROVIDER_VERIFIED=false
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_NOTIFICATION_TEMPLATE_ID=
EMAILJS_LINKED_REPLY_DISABLED_VERIFIED=false
EMAILJS_REPLY_TEMPLATE_ID=
EMAILJS_REPLY_VERIFIED=false
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are server-only runtime credentials.
# Never copy them into js/config.js, the browser, logs or the chat.
